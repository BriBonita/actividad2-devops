# Configuración del entorno del proyecto
# IMPORTANTE: No incluir credenciales AWS aquí (access key, secret key)
# Las credenciales se configuran en ~/.aws/credentials o mediante variables de entorno de AWS

# ID de la instancia EC2 a gestionar
INSTANCE_ID=i-xxxxxxxxxxxxxxxxx

# Nombre del bucket S3 de destino
BUCKET_NAME=mi-bucket-devops

# Directorio local a respaldar
DIRECTORY=./data

# Región de AWS
REGION=us-east-1
